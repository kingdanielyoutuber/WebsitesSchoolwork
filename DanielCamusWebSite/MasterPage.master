<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>My Website</title>

    <style>
        body {
            background-color: aquamarine;
            font-family: Arial;
            text-align: center;
        }

        /* title */
        .title {
            font-size: 30px;
            color: blue;
            border: 2px solid black;
            width: 60%;
            margin: 20px auto;
        }

        /* links like buttons */
        .nav a {
            background-color: #007BFF;
            color: white;
            padding: 8px 15px;
            margin: 5px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
        }

        /* עיצוב סטטוס התחברות */
        .user-status {
            margin-bottom: 10px;
            font-weight: bold;
            font-size: 18px;
        }
        .admin-color { color: red; }
        .user-color { color: darkblue; }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <div class="title">
        MY main website
    </div>

    <div class="user-status">
        <% 
            if (Session["userName"] != null) 
            { 
                // אם מנהל - צובע באדום, אחרת בכחול כהה
                string colorClass = (Session["userRole"] != null && Session["userRole"].ToString() == "admin") ? "admin-color" : "user-color";
                Response.Write("שלום, <span class='" + colorClass + "'>" + Session["userName"] + "</span>"); 
            } 
            else 
            { 
                Response.Write("שלום, אורח"); 
            } 
        %>
    </div>

    <div class="nav">
        
        <%-- קישורים שמוצגים לכולם (גם אם לא מחוברים) --%>
        <a href="messedform.aspx">messedformchaos</a>

        <%-- קישורים רק לאורחים (כשהסשן ריק) --%>
        <% if (Session["userRole"] == null) { %>
            <a href="Register.aspx">Register</a>
            <a href="Login.aspx">Login</a>
        <% } %>

        <%-- קישורים למשתמשים רשומים ומנהלים (כשהסשן מלא) --%>
        <% if (Session["userRole"] != null) { %>
            <a href="Home.aspx">Home</a>
            <a href="aspnet.aspx">לוח הכפל</a>
            <a href="showItems.aspx">showItems</a>
            <a href="Register.aspx">Register</a>
            <a href="Login.aspx">Login</a>
        <% } %>

        <%-- קישורים למנהל בלבד --%>
        <% if (Session["userRole"] != null && Session["userRole"].ToString() == "admin") { %>
            <a href="ShowMembers.aspx">ShowMembers</a>
            <a href="Registeritem.aspx">Registeritem</a>
        <% } %>

    </div>

    <hr />

    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

    <h1>The end</h1>
</body>
</html>