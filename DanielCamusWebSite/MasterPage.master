<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Daniel camus</title>

    <style>
        body {
            background-color: aquamarine;
            font-family: Arial;
            text-align: center;
        }

        /* title */
        .title {
            font-size: 30px;
            color: blue;
            border: 2px solid black;
            width: 60%;
            margin: 20px auto;
        }

        /* links like buttons */
        .nav a {
            background-color: #007BFF;
            color: white;
            padding: 8px 15px;
            margin: 5px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
        }

        /* עיצוב סטטוס התחברות */
        .user-status {
            margin-bottom: 10px;
            font-weight: bold;
            font-size: 18px;
        }
        .admin-color { color: red; }
        .user-color { color: darkblue; }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <div class="title">
        Daniel camus Randomliertems
    </div>

    <div class="user-status">
        <% 
            // 1. אם אף אחד לא מחובר (הסשן ריק)
            if (Session["UserName"] == null) 
            { 
                Response.Write("שלום, אורח"); 
            } 
            else 
            { 
                // 2. אם מישהו מחובר והוא מנהל
                if (Session["IsAdmin"] != null)
                {
                    Response.Write("שלום, <span class='admin-color'>" + Session["UserName"] + "</span>"); 
                }
                // 3. אם מישהו מחובר והוא משתמש רגיל
                else
                {
                    Response.Write("שלום, <span class='user-color'>" + Session["UserName"] + "</span>"); 
                }
            } 
        %>
    </div>

    <div class="nav">
        
        <%-- קישורים שמוצגים לכולם (אורחים, משתמשים ומנהלים) --%>
        <a href="introduction.aspx">introduction</a>
        <a href="ownerDanielinfo.aspx">ownerDanielinfo</a>
        <a href="Gallery.aspx">Gallery</a>
        

        <%-- קישורים שמוצגים רק לאורחים (כשאף אחד לא מחובר) --%>
        <% if (Session["UserName"] == null) { %>
            <a href="Register.aspx">Register</a>
            <a href="Login.aspx">Login</a>
        <% } %>

        <%-- קישורים שמוצגים לכל מי שמחובר (משתמשים רגילים ומנהלים) --%>
        <% if (Session["UserName"] != null) { %>
            <a href="duotable.aspx">לוח הכפל</a>
            <a href="showItems.aspx">showItems</a>
            <a href="Logout.aspx">Logout</a>
        <% } %>

        <%-- קישורים שמוצגים למנהל בלבד --%>
        <% if (Session["IsAdmin"] != null) { %>
            <a href="ShowMembers.aspx">ShowMembers</a>
            <a href="Registeritem.aspx">Registeritems</a>
        <% } %>

    </div>

    <hr />

    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

    <h1>The end</h1>
</body>
</html>